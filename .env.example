# Gemini API — Google AI Studio, free tier (aistudio.google.com/api-keys)
GOOGLE_GENERATIVE_AI_API_KEY=

# Zoho CRM — Self Client, api-console.zoho.<ZOHO_DC>
# See docs/PRD.md §6 for how these were obtained.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho data center domain suffix: com | in | eu | com.au | jp
# Determines both accounts.zoho.<dc> and www.zohoapis.<dc> hosts.
ZOHO_DC=
