# Groq API — free tier, no card required (console.groq.com/keys)
# Switched from Gemini — see docs/adr/0004-gemini-pro-as-llm-provider.md's
# final update: Gemini's free tier repeatedly failed to produce a first
# token within 20s, confirmed live, not just anecdotally slow.
GROQ_API_KEY=

# Zoho CRM — Self Client, api-console.zoho.<ZOHO_DC>
# See docs/PRD.md §6 for how these were obtained.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho data center domain suffix: com | in | eu | com.au | jp
# Determines both accounts.zoho.<dc> and www.zohoapis.<dc> hosts.
ZOHO_DC=
